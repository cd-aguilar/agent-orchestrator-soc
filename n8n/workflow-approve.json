{
  "name": "SOC Triage Approve",
  "nodes": [
    {
      "parameters": {
        "path": "soc-approve",
        "httpMethod": "POST",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "3a7d5e20-2f6c-4c3a-9f1a-000000000001",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [250, 300],
      "webhookId": "soc-orchestrator-approve"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://app:8000/triage/{{ $json.body.thread_id }}/approve",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"decision\": $json.body.decision } }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "3a7d5e20-2f6c-4c3a-9f1a-000000000002",
      "name": "POST /triage/{thread_id}/approve",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [500, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {}
      },
      "id": "3a7d5e20-2f6c-4c3a-9f1a-000000000003",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [750, 300]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [[{ "node": "POST /triage/{thread_id}/approve", "type": "main", "index": 0 }]]
    },
    "POST /triage/{thread_id}/approve": {
      "main": [[{ "node": "Respond to Webhook", "type": "main", "index": 0 }]]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  },
  "id": "soc-orchestrator-approve-workflow"
}
