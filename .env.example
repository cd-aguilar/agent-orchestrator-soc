# Copy this file to ".env" and fill in your real keys.
# ".env" is in .gitignore: it NEVER gets pushed to the repo.

# --- Ollama (local, no key required) ---
OLLAMA_HOST=http://localhost:11434

# --- Only if you migrate an agent to a cloud provider ---
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- Real threat intel (to replace the mock in tools.py) ---
# VIRUSTOTAL_API_KEY=
# ABUSEIPDB_API_KEY=
# OTX_API_KEY=

# --- n8n (docker-compose n8n service, basic auth) ---
# N8N_BASIC_AUTH_PASSWORD=

# --- Slack (n8n incoming webhook, triage report notifications) ---
# Create at api.slack.com/apps -> Blank app -> Incoming Webhooks -> Add
# New Webhook to Workspace, pick the target channel.
# SLACK_WEBHOOK_URL=
